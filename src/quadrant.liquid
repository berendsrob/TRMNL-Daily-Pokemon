<div class="view">
  <div class="layout">
    <div class="flex flex--col flex--center-x gap--xsmall h--full">
      <img class="image image--contain w--full" src="{{ artwork }}" style="flex:1 1 auto; min-height:0;" />
      <span class="value value--xsmall text--center" style="flex:0 0 auto;">{{ name }}</span>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">{{ t.title }}</span>
  </div>
</div>