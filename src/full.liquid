{% comment %}
  Pokemon of the Day - Full layout, tuned for TRMNL X (4-bit greyscale).
  All chrome text comes from {{ t.* }}, set by the Language form field.
{% endcomment %}

<div class="view view--full">
  <div class="layout">

    <div class="flex flex--row gap--large" style="height:100%; align-items:center;">

      <!-- Artwork -->
      <div style="flex:0 0 50%; display:flex; flex-direction:column; align-items:center; gap:4px;">
        <img class="image"
             src="{{ artwork }}"
             style="width:100%; aspect-ratio:1/1; object-fit:contain;" />
        <span class="text--gray-40" style="font-size:0.7rem;">{{ t.number }} {{ dex_padded }}</span>
      </div>

      <!-- Details -->
      <div style="flex:1 1 auto; min-width:0;">

        <span class="value value--large" style="display:block; line-height:1.05;">
          {{ name }}
        </span>

        <span class="text--gray-40" style="display:block; margin-top:2px; font-size:0.7rem;">
          {{ genus }} &middot; {{ generation_label }}{% if is_legendary %} &middot; {{ t.legendary }}{% endif %}{% if is_mythical %} &middot; {{ t.mythical }}{% endif %}
        </span>

        <!-- Types -->
        <div class="flex flex--row gap--small" style="margin:8px 0;">
          <span class="outline" style="padding:2px 12px; font-weight:700; font-size:0.85rem;">
            {{ type_1 | upcase }}
          </span>
          {% if type_2 != "" %}
          <span class="outline" style="padding:2px 12px; font-weight:700; font-size:0.85rem;">
            {{ type_2 | upcase }}
          </span>
          {% endif %}
        </div>

        <!-- Flavor text -->
        {% if flavor != "" %}
        <p style="margin:0 0 8px 0; font-size:0.78rem; line-height:1.3;
                  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
          {{ flavor }}
        </p>
        {% endif %}

        <div class="border--h-25" style="height:2px;"></div>

        <!-- Headline figures -->
        <div class="flex flex--row" style="margin:8px 0 10px 0; gap:26px;">
          <div>
            <span class="text--gray-40" style="display:block; font-size:0.68rem;">{{ t.height }}</span>
            <span style="font-size:1.4rem; font-weight:700; line-height:1;">{{ height_m }}<span style="font-size:0.8rem;"> m</span></span>
          </div>
          <div>
            <span class="text--gray-40" style="display:block; font-size:0.68rem;">{{ t.weight }}</span>
            <span style="font-size:1.4rem; font-weight:700; line-height:1;">{{ weight_kg }}<span style="font-size:0.8rem;"> kg</span></span>
          </div>
          <div>
            <span class="text--gray-40" style="display:block; font-size:0.68rem;">{{ t.total }}</span>
            <span style="font-size:1.4rem; font-weight:700; line-height:1;">{{ stat_total }}</span>
          </div>
        </div>

        <!-- Base stats -->
        <div style="display:flex; flex-direction:column; gap:3px;">
          {% for stat in stats %}
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="text--gray-40" style="flex:0 0 62px; font-size:0.72rem;">{{ stat.label }}</span>
            <div class="bg--gray-10 rounded" style="flex:1 1 auto; height:10px; overflow:hidden;">
              <div class="bg--gray-75" style="width:{{ stat.pct }}%; height:100%;"></div>
            </div>
            <span style="flex:0 0 30px; text-align:right; font-size:0.78rem; font-weight:700;">{{ stat.value }}</span>
          </div>
          {% endfor %}
        </div>

        <!-- Abilities -->
        <div style="margin-top:10px;">
          <span class="text--gray-40" style="display:block; margin-bottom:1px; font-size:0.68rem;">
            {{ t.abilities }}
          </span>
          <div style="font-size:0.8rem;">
            {% for ability in abilities %}{% if forloop.index0 > 0 %}<span class="text--gray-40"> &middot; </span>{% endif %}{{ ability.name }}{% if ability.hidden %}<span class="text--gray-40" style="font-size:0.68rem;"> ({{ t.hidden }})</span>{% endif %}{% endfor %}
          </div>
        </div>

        <!-- Evolution chain -->
        {% if has_evolution %}
        <div style="margin-top:8px;">
          <span class="text--gray-40" style="display:block; margin-bottom:1px; font-size:0.68rem;">
            {{ t.evolution }}
          </span>
          <div class="flex flex--row gap--small" style="align-items:center; flex-wrap:wrap; font-size:0.8rem;">
            {% for stage in stages %}
              {% if forloop.index0 > 0 %}
                <span class="text--gray-40">&rarr;</span>
              {% endif %}
              {% if stage.current %}
                <span style="font-weight:700;">{{ stage.label }}</span>
              {% else %}
                <span class="text--gray-40">{{ stage.label }}</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">{{ t.title }}</span>
    <span class="instance">{{ date }}</span>
  </div>
</div>