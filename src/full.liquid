<div class="view">
  <div class="layout layout--col gap--medium">

    <div class="flex flex--row flex--center-y gap--xlarge" style="flex:1 1 auto; min-height:0;">

      <div class="flex flex--col flex--center-x flex--center-y gap--xsmall" style="flex:0 0 52%; height:100%;">
        <img class="image image--contain w--full" src="{{ artwork }}" style="height:100%;" />
        <span class="label text--gray-40">{{ t.number }} {{ dex_padded }}</span>
      </div>

      <div class="flex flex--col gap--small" style="flex:1 1 auto; min-width:0;">

        <span class="value value--large">{{ name }}</span>

        <span class="description text--gray-40">
          {{ genus }} &middot; {{ generation_label }}{% if is_legendary %} &middot; {{ t.legendary }}{% endif %}{% if is_mythical %} &middot; {{ t.mythical }}{% endif %}
        </span>

        <div class="flex flex--row gap--small">
          <span class="outline value value--xsmall px--large py--xsmall">{{ type_1 | upcase }}</span>
          {% if type_2 != "" %}
          <span class="outline value value--xsmall px--large py--xsmall">{{ type_2 | upcase }}</span>
          {% endif %}
        </div>

        {% if flavor != "" %}
        <span class="description" data-clamp="3">{{ flavor }}</span>
        {% endif %}

        <div class="border--h-25" style="height:2px;"></div>

        <div class="flex flex--row gap--xxlarge">
          <div class="flex flex--col">
            <span class="label text--gray-40">{{ t.height }}</span>
            <span class="value value--large value--tnums">{{ height_m }} m</span>
          </div>
          <div class="flex flex--col">
            <span class="label text--gray-40">{{ t.weight }}</span>
            <span class="value value--large value--tnums">{{ weight_kg }} kg</span>
          </div>
        </div>

      </div>
    </div>

    {% if has_evolution %}
    <div class="flex flex--col gap--xsmall" style="flex:0 0 auto;">
      <div class="border--h-25" style="height:2px;"></div>
      <div class="flex flex--row flex--center-x flex--center-y gap--medium">
        {% for stage in others %}
          {% if forloop.index0 > 0 %}
            <span class="value value--small text--gray-40">&rarr;</span>
          {% endif %}
          {% if stage.marker %}
            <div class="flex flex--col flex--center-x flex--center-y">
              <span class="value value--small">&uarr;</span>
              <span class="label text--gray-40 text--center">{{ name }}</span>
            </div>
          {% else %}
            {% for m in stage.members %}
            <div class="flex flex--col flex--center-x" style="flex:1 1 0; min-width:0; max-width:210px;">
              {% if m.art != "" %}
              <img class="image image--contain w--full" src="{{ m.art }}" style="max-height:180px;" />
              {% endif %}
              <span class="label text--center">{{ m.name }}</span>
            </div>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>

  <div class="title_bar">
    <span class="title">{{ t.title }}</span>
    <span class="instance">{{ date }}</span>
  </div>
</div>