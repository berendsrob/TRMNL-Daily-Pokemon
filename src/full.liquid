{% comment %}
  Pokemon of the Day - Full layout, tuned for TRMNL X (4-bit greyscale).
  All chrome text comes from {{ t.* }}, set by the Language form field.
{% endcomment %}

<div class="view view--full">
  <div class="layout">

    <div class="flex flex--row gap--large" style="height:100%; align-items:center;">

      <!-- Artwork -->
      <div style="flex:0 0 50%; display:flex; flex-direction:column; align-items:center; gap:6px;">
        <img class="image"
             src="{{ artwork }}"
             style="width:100%; aspect-ratio:1/1; object-fit:contain;" />
        <span class="text--gray-40" style="font-size:0.78rem;">{{ t.number }} {{ dex_padded }}</span>
      </div>

      <!-- Details -->
      <div style="flex:1 1 auto; min-width:0;">

        <span class="value value--large" style="display:block; line-height:1.05;">
          {{ name }}
        </span>

        <span class="text--gray-40" style="display:block; margin-top:4px; font-size:0.78rem;">
          {{ genus }} &middot; {{ generation_label }}{% if is_legendary %} &middot; {{ t.legendary }}{% endif %}{% if is_mythical %} &middot; {{ t.mythical }}{% endif %}
        </span>

        <!-- Types -->
        <div class="flex flex--row gap--small" style="margin:14px 0 0 0;">
          <span class="outline" style="padding:3px 13px; font-weight:700; font-size:0.93rem;">
            {{ type_1 | upcase }}
          </span>
          {% if type_2 != "" %}
          <span class="outline" style="padding:3px 13px; font-weight:700; font-size:0.93rem;">
            {{ type_2 | upcase }}
          </span>
          {% endif %}
        </div>

        <!-- Flavor text -->
        {% if flavor != "" %}
        <p style="margin:16px 0 0 0; font-size:0.86rem; line-height:1.35;
                  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
          {{ flavor }}
        </p>
        {% endif %}

        <div class="border--h-25" style="height:2px; margin-top:16px;"></div>

        <!-- Height / weight -->
        <div class="flex flex--row" style="margin-top:14px; gap:36px;">
          <div>
            <span class="text--gray-40" style="display:block; font-size:0.76rem;">{{ t.height }}</span>
            <span style="font-size:1.5rem; font-weight:700; line-height:1;">{{ height_m }}<span style="font-size:0.88rem;"> m</span></span>
          </div>
          <div>
            <span class="text--gray-40" style="display:block; font-size:0.76rem;">{{ t.weight }}</span>
            <span style="font-size:1.5rem; font-weight:700; line-height:1;">{{ weight_kg }}<span style="font-size:0.88rem;"> kg</span></span>
          </div>
        </div>

        <!-- Base stats -->
        <div style="display:flex; flex-direction:column; gap:5px; margin-top:16px;">
          {% for stat in stats %}
          <div style="display:flex; align-items:center; gap:9px;">
            <span class="text--gray-40" style="flex:0 0 70px; font-size:0.80rem;">{{ stat.label }}</span>
            <div class="bg--white rounded" style="flex:1 1 auto; height:11px; overflow:hidden;">
              <div class="bg--gray-70" style="width:{{ stat.pct }}%; height:100%;"></div>
            </div>
            <span style="flex:0 0 34px; text-align:right; font-size:0.86rem; font-weight:700;">{{ stat.value }}</span>
          </div>
          {% endfor %}
        </div>

        <!-- Abilities -->
        <div style="margin-top:18px;">
          <span class="text--gray-40" style="display:block; margin-bottom:3px; font-size:0.76rem;">
            {{ t.abilities }}
          </span>
          <div style="font-size:0.88rem;">
            {% for ability in abilities %}{% if forloop.index0 > 0 %}<span class="text--gray-40"> &middot; </span>{% endif %}{{ ability.name }}{% if ability.hidden %}<span class="text--gray-40" style="font-size:0.76rem;"> ({{ t.hidden }})</span>{% endif %}{% endfor %}
          </div>
        </div>

        <!-- Evolution chain -->
        {% if has_evolution %}
        <div style="margin-top:18px;">
          <span class="text--gray-40" style="display:block; margin-bottom:5px; font-size:0.76rem;">
            {{ t.evolution }}
          </span>
          <div style="display:flex; align-items:flex-start; gap:9px; flex-wrap:wrap;">
            {% for stage in stages %}
              {% if forloop.index0 > 0 %}
                <span class="text--gray-40" style="align-self:center; font-size:1.3rem;">&rarr;</span>
              {% endif %}
              {% if stage.count > 3 %}
                <span class="text--gray-40" style="align-self:center; font-size:0.95rem;">
                  {{ stage.count }}&times;
                </span>
              {% else %}
              <div style="display:flex; gap:8px;">
                {% for m in stage.members %}
                <div style="display:flex; flex-direction:column; align-items:center; width:92px;">
                  {% if m.sprite != "" %}
                  <img class="image" src="{{ m.sprite }}"
                       style="width:84px; height:84px; object-fit:contain;
                              {% unless m.current %}opacity:0.55;{% endunless %}" />
                  {% endif %}
                  <span style="font-size:0.88rem; line-height:1.15; text-align:center;
                               {% if m.current %}font-weight:700;{% else %}opacity:0.7;{% endif %}">
                    {{ m.name }}
                  </span>
                </div>
                {% endfor %}
              </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">{{ t.title }}</span>
    <span class="instance">{{ date }}</span>
  </div>
</div>