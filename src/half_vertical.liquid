<div class="view">
  <div class="layout">
    <div class="flex flex--col flex--center-x gap--small h--full">

      <img class="image image--contain w--full" src="{{ artwork }}" style="flex:1 1 auto; min-height:0;" />

      <div class="flex flex--col flex--center-x gap--xsmall" style="flex:0 0 auto;">
        <span class="value value--small text--center">{{ name }}</span>
        <div class="flex flex--row flex--center-x gap--xsmall">
          <span class="outline label px--medium">{{ type_1 | upcase }}</span>
          {% if type_2 != "" %}
          <span class="outline label px--medium">{{ type_2 | upcase }}</span>
          {% endif %}
        </div>
        <div class="flex flex--row flex--center-x gap--large">
          <div class="flex flex--col flex--center-x">
            <span class="label text--gray-40">{{ t.height }}</span>
            <span class="value value--xsmall value--tnums">{{ height_m }} m</span>
          </div>
          <div class="flex flex--col flex--center-x">
            <span class="label text--gray-40">{{ t.weight }}</span>
            <span class="value value--xsmall value--tnums">{{ weight_kg }} kg</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="title_bar">
    <span class="title">{{ t.title }}</span>
    <span class="instance">{{ t.number }} {{ dex_padded }}</span>
  </div>
</div>